meta {
  name: Create a fundraiser (NGO or ADMIN)
  type: http
  seq: 2
}

post {
  url: {{baseUrl}}/api/fundraisers
  body: json
  auth: bearer
}

auth:bearer {
  token: {{token}}
}

body:json {
  {
    "title": "Winter Shelter Fund",
    "description": "Blankets and heating for the shelter.",
    "targetAmount": 5000,
    "ngo": "{{ngoId}}"
  }
}

script:post-response {
  if (res.status < 300 && res.body && res.body._id) {
    bru.setVar("fundraiserId", res.body._id);
  }
}

docs {
  NGO or ADMIN role, and the NGO must be `approved`.
}
