MONGO_CONNECTION=mongodb://localhost:27017/pawconnect
JWT_SECRET=replace-with-a-long-random-string
PORT=3002

# --- Deployment (optional for local development) ---

# Comma-separated frontend origins allowed to call the API, e.g.
# CORS_ORIGIN=https://pawconnect.example.com,https://www.pawconnect.example.com
# If unset: all origins are allowed in development, none when NODE_ENV=production.
CORS_ORIGIN=

# Set to true when running behind a hosting proxy or load balancer (Render, Railway, Heroku...)
# so rate limiting uses the client's IP from X-Forwarded-For instead of the proxy's.
TRUST_PROXY=false

# Set to production when deployed.
# NODE_ENV=production
